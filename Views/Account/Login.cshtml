@using FinalProReRe.Models
@model LoginViewModel

<!DOCTYPE html>
<html lang="en" >

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log In</title>
    <link rel="stylesheet" href="~/Content/Site.css" type="text/css" />
    <link rel="stylesheet" href="~/Content/Style.css" type="text/css" />
    <link rel="stylesheet" href="~/Content/bootstrap-theme.css" type="text/css" />
    <link rel="stylesheet" href="~/Content/bootstrap-theme.css.map" type="text/css" />
    <link rel="stylesheet" href="~/Content/bootstrap-theme.min.css" type="text/css" />
    <link rel="stylesheet" href="~/Content/bootstrap-theme.min.css.map" type="text/css" />
    <link rel="stylesheet" href="~/Content/bootstrap.css" type="text/css" />

    <script src="https://use.fontawesome.com/releases/v5.13.0/js/all.js" crossorigin="anonymous"></script>

    <style>
        #demo-credentials {
            margin-top: 1.25rem;
            padding: 0.9rem 1.1rem;
            max-width: 22rem;
            border: 1px solid rgba(0,0,0,0.12);
            border-left: 3px solid #5b8def;
            border-radius: 4px;
            background: rgba(255,255,255,0.92);
            font-size: 0.9rem;
            line-height: 1.45;
        }
        #demo-credentials strong { display:block; margin-bottom:0.35rem; }
        #demo-credentials p { margin:0 0 0.6rem; color:#444; }
        #demo-credentials dl { margin:0; display:grid; grid-template-columns:auto 1fr; gap:0.15rem 0.6rem; }
        #demo-credentials dt { font-weight:600; color:#555; }
        #demo-credentials dd { margin:0; }
        #demo-credentials code { font-size:0.9em; padding:0.1rem 0.3rem; background:rgba(0,0,0,0.06); border-radius:3px; }
        #demo-credentials .note { margin:0.35rem 0 0; font-size:0.83rem; color:#666; }
        #demo-credentials .acct { padding:0.6rem 0; border-top:1px solid rgba(0,0,0,0.08); }
        #demo-credentials .acct:first-of-type { border-top:0; padding-top:0.2rem; }
        #demo-credentials .role { display:block; font-weight:600; font-size:0.87rem; margin-bottom:0.3rem; color:#333; }
        #demo-credentials .primary .role { color:#3a6fd8; }
    </style>
</head>
<body id="loginbody">
    <div>
        <img id="img" src="~/Content/images/loginimage-jumbo.jpg" />
    </div>

    <div id="heading">

        <a href="/home/employeeindex">Home</a> <a target="_blank" href="https://docs.google.com/document/d/1eh-c7nNmuU6CRv5ZS2dTp5LpFqJEkoIwypHCYVvm_4I/edit?tab=t.0">Contact Me</a> <a target="_blank" href="https://gallaghercareer.github.io/portfolio-2025">Portfolio</a>
    </div>
    <div style="align-content: center; display:flex; flex-direction:column; align-items:center;">
       
        @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form", style = "justify-content: center; display: flex; flex-direction:column; " }))
        {
            @Html.AntiForgeryToken()

            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div>

        @Html.LabelFor(m => m.Email, new { @class = "control-label" })

        @Html.TextBoxFor(m => m.Email, "", new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })

    </div>


    <div>
        @Html.LabelFor(m => m.Password, new { @class = "control-label" })
        @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            <input id="buttonadd" type="submit" value="Log in" class="btn btn-default" style="width:100%; margin-top:5px;" />
        </div>
        }

        <div id="demo-credentials">
            <strong>Demo accounts</strong>
            <p>
                This app uses role-based access control. Sign in with either account
                to see how permissions change what the interface offers.
            </p>

            <div class="acct primary">
                <span class="role">Manager &mdash; full access</span>
                <dl>
                    <dt>Email</dt><dd><code>admin@hiring.com</code></dd>
                    <dt>Password</dt><dd><code>@ViewBag.DemoPassword</code></dd>
                </dl>
                <p class="note">Add and delete tickets, mark them resolved, comment.</p>
            </div>

            <div class="acct">
                <span class="role">Employee &mdash; restricted</span>
                <dl>
                    <dt>Email</dt><dd><code>employee@hiring.com</code></dd>
                    <dt>Password</dt><dd><code>@ViewBag.DemoEmployeePassword</code></dd>
                </dl>
                <p class="note">View tickets and comment only &mdash; the management controls are gone.</p>
            </div>
        </div>
    </div>
</body>
</html>



    



@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
}
<script>

    console.log("start");
    $(function () {
        $('[data-toggle="tooltip"]').tooltip()
    });

</script>
